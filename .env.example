BLUEPRINTANDCHILL_ENV=development
BLUEPRINTANDCHILL_DEBUG=true
BLUEPRINTANDCHILL_APP_NAME=BlueprintAndChill
BLUEPRINTANDCHILL_HOST=0.0.0.0
BLUEPRINTANDCHILL_PORT=8000
BLUEPRINTANDCHILL_REQUEST_DATA_DIR=local_data/requests

# Entra ID / Azure AD placeholders only.
# TODO: replace with real values in deployment-time configuration, not in source control.
BLUEPRINTANDCHILL_ENTRA_TENANT_ID=
BLUEPRINTANDCHILL_ENTRA_CLIENT_ID=
BLUEPRINTANDCHILL_ENTRA_CLIENT_SECRET=
BLUEPRINTANDCHILL_ENTRA_AUTHORITY=https://login.microsoftonline.com
BLUEPRINTANDCHILL_ENTRA_REDIRECT_PATH=/auth/callback
BLUEPRINTANDCHILL_ENTRA_SCOPES=openid,profile,email
